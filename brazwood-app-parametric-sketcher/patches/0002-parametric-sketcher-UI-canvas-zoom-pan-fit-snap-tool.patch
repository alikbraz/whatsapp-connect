+  typed?: string
+}
+
+const HIT_TOL_PX = 9
+
+const C = {
+  grid: '#ececea',
+  gridMajor: '#dcdcd8',
+  axis: '#c9c9c4',
+  line: '#1f1f1f',
+  wallExt: '#c7c7c2',
+  wallInt: '#e4e4e0',
