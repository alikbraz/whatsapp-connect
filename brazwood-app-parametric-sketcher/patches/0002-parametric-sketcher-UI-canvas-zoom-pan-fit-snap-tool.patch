+const ROLE_OPTIONS: { v: StructuralRole; he: string }[] = (['bearing', 'non-bearing', 'none'] as StructuralRole[]).map((v) => ({ v, he: ROLE_LABEL_HE[v] }))
+const FACE_OPTIONS: { v: WallFaceRef; he: string }[] = [
