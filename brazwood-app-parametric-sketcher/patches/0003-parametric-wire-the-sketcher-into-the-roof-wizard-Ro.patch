+        const user = typeof over === 'number' && Number.isFinite(over) && over >= 0 ? over : kept?.overhangUser
+        return {
+          ...e,
+          ...(kept ? { kind: kept.kind } : {}),
+          ...(user !== undefined ? { overhangM: user, overhangUser: user } : {}),
