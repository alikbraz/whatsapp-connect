@@ -3536,6 +3552,31 @@ export function roofReducer(m: RoofModel, a: RoofAction): RoofModel {
       return { ...m, trussCount: Math.round(a.value) }
     }
     // === END ROOF OPENINGS + TECHNICAL ZONE + TRUSSES REDUCER CASES ===
+    case 'setParametricSketch':
+      return m.parametricSketch === a.doc ? m : { ...m, parametricSketch: a.doc }
+    case 'adoptParametricSketch': {
+      if (a.contour.length < 4) return { ...m, parametricSketch: a.doc }
+      const prevEdgeAttrs = m.templateId === 'free' ? m.edgeAttrs : undefined
+      const withDoc: RoofModel = { ...m, parametricSketch: a.doc }
+      const adopted = roofReducer(withDoc, { kind: 'importBuilding', contour: a.contour })
+      if (adopted === withDoc) return withDoc
+      const n = adopted.contour.length
+      const edgeAttrs = (adopted.edgeAttrs ?? []).map((e, k) => {
+        const kept = prevEdgeAttrs && prevEdgeAttrs.length === n ? prevEdgeAttrs[k] : undefined
+        const over = a.edgeOverhangM?.[k]
+        // A sketch overhang request is a USER value on that edge (T7's
