+      })
+      const slopePct = a.slopePct !== undefined && Number.isFinite(a.slopePct) && a.slopePct >= MIN_SLOPE_PCT ? a.slopePct : adopted.slopePct
+      return regenerate({ ...adopted, edgeAttrs, slopePct, parametricSketch: a.doc })
+    }
     case 'dismissError':
